-- livingdb roles — TEMPLATE. Never commit filled values.
-- Placeholders (__NAME__) are substituted on the spark from
-- /home/brrew/srv/living/.env at apply time. See server/postgrest/README.

-- Read-only role used by PostgREST anonymous access (the dashboard UI).
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'living_reader') THEN
    CREATE ROLE living_reader NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'living_writer') THEN
    CREATE ROLE living_writer NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'living_authenticator') THEN
    CREATE ROLE living_authenticator NOLOGIN;
  END IF;
END
$$;

GRANT USAGE ON SCHEMA public TO living_reader, living_writer;
GRANT SELECT ON hosts, scans, inventory_current, inventory_history,
  metrics_ts, metrics_5m, metrics_1h, events, bookmarks, log_sources
  TO living_reader;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO living_reader;
-- The dashboard UI (behind the existing basic auth) may ack/dismiss events.
GRANT UPDATE (acked, dismissed) ON events TO living_reader;

-- Writer: what installed agents may do (ingest + heartbeat + claim).
GRANT SELECT, INSERT ON scan_staging TO living_writer;
GRANT USAGE, SELECT ON SEQUENCE scan_staging_staging_id_seq TO living_writer;
GRANT SELECT, INSERT, UPDATE ON hosts TO living_writer;
GRANT SELECT, INSERT ON metrics_ts TO living_writer;
GRANT SELECT ON host_revocations TO living_writer;
GRANT EXECUTE ON FUNCTION claim_enrollment_token(TEXT, TEXT, TEXT, TEXT, TEXT)
  TO living_writer;
-- Anon (pre-enrollment) may only claim tokens.
GRANT EXECUTE ON FUNCTION claim_enrollment_token(TEXT, TEXT, TEXT, TEXT, TEXT)
  TO living_reader;

-- Memberships: authenticator can switch to either via JWT role claim.
GRANT living_reader TO living_authenticator;
GRANT living_writer TO living_authenticator;

-- Password for the authenticator login role (PostgREST PGRST_DB_URI).
-- Substituted at apply time; never stored here.
ALTER ROLE living_authenticator WITH LOGIN PASSWORD '__AUTH_PASSWORD__';

-- The sync daemon runs as the postgres superuser-equivalent writer on the
-- spark itself (local socket, no password); it owns the differ, not PostgREST.
